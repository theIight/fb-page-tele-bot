# Link trang Facebook cần theo dõi (bắt buộc)
# Ví dụ: https://www.facebook.com/MetaVietnam hoặc https://www.facebook.com/vtv24
FB_PAGE_URL=https://www.facebook.com/MetaVietnam

# Token bot Telegram lấy từ @BotFather (bắt buộc)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID nhận tin nhắn (ID của bạn, group chat hoặc channel)
# Dùng bot @userinfobot hoặc @myidbot trên Telegram để lấy ID
TELEGRAM_CHAT_ID=123456789

# Chu kỳ kiểm tra và reload lại trang (đơn vị: giây, mặc định: 60)
CHECK_INTERVAL_SECONDS=60

# Chạy ẩn trình duyệt không hiện cửa sổ (true / false, mặc định: true)
HEADLESS=true

# Thông báo các bài hiện có khi bot khởi động lần đầu (true / false, mặc định: false)
# false: Bot lưu các bài đang có vào bộ nhớ và chỉ gửi thông báo khi có bài đăng MỚI sau này.
# true: Bot sẽ gửi thông báo các bài viết mới nhất đang có ngay khi vừa bật bot lần đầu.
NOTIFY_ON_START=false

# (Tuỳ chọn) Đường dẫn thư mục lưu session trình duyệt để giữ trạng thái đăng nhập
# Mặc định: ./user_data
USER_DATA_DIR=./user_data

# (Tuỳ chọn) Cookie Facebook nếu muốn dùng dạng chuỗi cookie (thay thế đăng nhập thủ công)
# Ví dụ: c_user=1000...; xs=...; datr=...;
FB_COOKIES=
